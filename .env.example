# Where the automation container reaches your Foundry server.
#   Foundry on this same machine:        http://host.docker.internal:30000
#   Foundry on another machine on LAN:   http://192.168.1.50:30000
FOUNDRY_URL=http://host.docker.internal:30000

# A Foundry user with the Gamemaster role, made just for the assistant (e.g. "AutoPrep").
AUTOPREP_USER=AutoPrep
AUTOPREP_PASSWORD=

# Optional: pin the hub token instead of generating one.
AUTOPREP_TOKEN=
AUTOPREP_PORT=30777
